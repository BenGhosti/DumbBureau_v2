# ---------------------------------------------------------------------
# DumbBureau - Environment Configuration
# Copy to `.env` and adjust for your deployment.
# ---------------------------------------------------------------------

# ---- Public hostname & ports (Caddy reverse proxy) --------------------
# The DNS name or LAN IP the app is reached at. NO scheme, NO port.
# Must match WEBAUTHN_RP_ID exactly. Caddy uses it for its TLS cert and
# site routing. Examples: `dumbbureau.local` or `192.168.188.50`.
DUMBBUREAU_HOSTNAME=dumbbureau.local

# External ports (published by the `caddy` profile):
#   8360 = HTTPS (main entry point, WebAuthn/Passkeys need this)
#   8361 = HTTP  -> redirects to 8360
# The backend/frontend containers are NOT published to the host; all traffic
# goes through Caddy.

# ---- Secrets ---------------------------------------------------------
# Secret used to bootstrap the FIRST admin user registration.
# Only honored when no users exist yet. MUST be set for initial setup.
ADMIN_RECOVERY_SECRET=change-me-before-first-run

# Secret used to sign JWT session tokens. MUST be changed in production.
# Use at least 32 random bytes (e.g. `openssl rand -hex 32`).
SECRET_KEY=change-me-in-production

# Optional dedicated key for at-rest encryption (AES-128-GCM, key via Argon2id).
# Task descriptions and audit-log details are encrypted with it.
# Falls back to SECRET_KEY when left empty.
ENCRYPTION_KEY=

# ---- WebAuthn --------------------------------------------------------
# RP ID is the registrable domain (no scheme/port); Origin is scheme+host+port.
# With Caddy: RP_ID = DUMBBUREAU_HOSTNAME, Origin = https://<host>:8360.
# For local testing via http://localhost:8360 use "localhost" + that origin.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=DumbBureau
WEBAUTHN_ORIGIN=http://localhost:8360

# ---- Storage ---------------------------------------------------------
# SQLite database location (inside the container).
# If you change APPDATA_DIR, adjust DATABASE_URL to the same container path.
DATABASE_URL=sqlite:////appdata/dumbbureau/db.sqlite

# Host directory mounted into the container at /appdata/dumbbureau
# (database, templates, exports, logs, backups).
APPDATA_DIR=/appdata/dumbbureau

# ---- Networking / Security ------------------------------------------
# Trusted reverse proxy CIDRs. This MUST be the internal Docker network
# (172.28.1.0/24), NOT the LAN subnet — the LAN is untrusted by design so a
# client cannot spoof X-Forwarded-For and bypass rate limiting.
TRUSTED_PROXY_IPS=172.28.1.0/24

# Comma separated list of allowed CORS origins (the public frontend URL).
CORS_ORIGINS=http://localhost:8360

# ---- Rate limiting ---------------------------------------------------
# In-memory sliding-window limiter applied to auth endpoints, keyed by the
# resolved client IP. Tune or disable as needed.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# ---- Backups ---------------------------------------------------------
# Number of daily SQLite online backups kept under <appdata>/backups/.
# A consistent snapshot is taken automatically every 24h; see README for
# manual backup and restore.
BACKUP_RETENTION=7

# ---- Token lifetimes -------------------------------------------------
# WebAuthn challenge validity (seconds).
CHALLENGE_TTL_SECONDS=300
# JWT session token validity (minutes).
ACCESS_TOKEN_TTL_MINUTES=60
# Invite token validity (days).
INVITE_TOKEN_TTL_DAYS=7
# Passkey recovery token validity (minutes).
RECOVERY_TOKEN_TTL_MINUTES=30

# ---- Logging ---------------------------------------------------------
LOG_LEVEL=INFO
