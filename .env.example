# ---------------------------------------------------------------------
# DumbBureau - Environment Configuration
# Copy to `.env` and adjust for your deployment.
# ---------------------------------------------------------------------

# ---- Public hostname & ports ----------------------------------------
# The app is exposed behind your own reverse proxy (nginx etc.) that
# terminates TLS/HTTPS. The two host ports below are published by the
# Docker stack; your proxy points its upstream at FRONTEND_PORT.
FRONTEND_PORT=8360
# Optional direct access to the API (debugging); not required by the web app.
BACKEND_PORT=8361

# ---- WebAuthn --------------------------------------------------------
# IMPORTANT: These must match the URL the app is reached at through your
# reverse proxy (WebAuthn requires a secure HTTPS context).
#   WEBAUTHN_RP_ID   = the registrable domain (NO scheme/port) = your subdomain
#   WEBAUTHN_ORIGIN  = scheme + host (+ port only if non-standard)
# Replace `dumbbureau.example.com` with your real subdomain in your local .env.
WEBAUTHN_RP_ID=dumbbureau.example.com
WEBAUTHN_RP_NAME=DumbBureau
WEBAUTHN_ORIGIN=https://dumbbureau.example.com

# ---- Secrets ---------------------------------------------------------
# Secret used to bootstrap the FIRST admin user registration.
# Only honored when no users exist yet. MUST be set for initial setup.
ADMIN_RECOVERY_SECRET=change-me-before-first-run

# Secret used to sign JWT session tokens. MUST be changed in production.
# Use at least 32 random bytes (e.g. `openssl rand -hex 32`).
SECRET_KEY=change-me-in-production

# Optional dedicated key for at-rest encryption (AES-128-GCM, key via Argon2id).
# Task descriptions and audit-log details are encrypted with it.
# Falls back to SECRET_KEY when left empty.
ENCRYPTION_KEY=

# ---- Storage ---------------------------------------------------------
# SQLite database location (inside the container).
# If you change APPDATA_DIR, adjust DATABASE_URL to the same container path.
DATABASE_URL=sqlite:////appdata/dumbbureau/db.sqlite

# Host directory mounted into the container at /appdata/dumbbureau
# (database, templates, exports, logs). On Unraid e.g. /mnt/user/appdata/dumbbureau.
APPDATA_DIR=/appdata/dumbbureau

# ---- Networking / Security ------------------------------------------
# Trusted reverse proxy CIDRs (comma/space separated). Used to resolve the real
# client IP for rate limiting. Set this to:
#   1) the fixed IP of your reverse proxy (if it sets X-Real-IP/X-Forwarded-For), and
#   2) the Docker bridge range 172.16.0.0/12 so the internal frontend->backend
#      hop is recognized as a proxy hop (not the client).
# Do NOT put your whole LAN subnet here — that would let any client spoof its IP.
TRUSTED_PROXY_IPS=192.168.1.2, 172.16.0.0/12

# Comma separated list of allowed CORS origins (the public frontend URL).
# For same-origin deployments (proxy serves app + API on one origin) this is
# barely used, but keep it aligned with WEBAUTHN_ORIGIN anyway.
CORS_ORIGINS=https://dumbbureau.example.com

# ---- Rate limiting ---------------------------------------------------
# In-memory sliding-window limiter applied to auth endpoints, keyed by the
# resolved client IP. Tune or disable as needed.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# ---- Token lifetimes -------------------------------------------------
# WebAuthn challenge validity (seconds).
CHALLENGE_TTL_SECONDS=300
# JWT session token validity (minutes).
ACCESS_TOKEN_TTL_MINUTES=60
# Invite token validity (days).
INVITE_TOKEN_TTL_DAYS=7
# Passkey recovery token validity (minutes).
RECOVERY_TOKEN_TTL_MINUTES=30

# ---- Logging ---------------------------------------------------------
LOG_LEVEL=INFO
