# ---------------------------------------------------------------------
# DumbBureau - Environment Configuration
# Copy to `.env` and adjust for your deployment.
#
# `.env` is gitignored on purpose - your real subdomain, proxy IP, and
# secrets never belong in this template file, only in your local copy.
# ---------------------------------------------------------------------

# ---- Ports (docker-compose) ------------------------------------------
# Host port of the web app. Reached by YOUR external reverse proxy
# (own nginx / macvlan container) - not exposed to the internet directly.
FRONTEND_PORT=8360
# The backend has no host port mapping by default - it's only reachable
# from other containers on the compose network (frontend -> backend).
# If you ever need to reach it directly from the host (debugging), add a
# `ports: ["8361:8000"]` line under the backend service in
# docker-compose.yml yourself; pick a port that's actually free on your
# host first (`docker ps` / `ss -tlnp` to check).

# ---- Secrets ---------------------------------------------------------
# Secret used to bootstrap the FIRST admin user registration.
# Only honored when no users exist yet. MUST be set for initial setup.
ADMIN_RECOVERY_SECRET=change-me-before-first-run

# Secret used to sign JWT session tokens. MUST be changed in production.
# Use at least 32 random bytes (e.g. `openssl rand -hex 32`).
SECRET_KEY=change-me-in-production

# Optional dedicated key for at-rest encryption (AES-128-GCM, key via Argon2id).
# Task descriptions and audit-log details are encrypted with it.
# Falls back to SECRET_KEY when left empty.
ENCRYPTION_KEY=

# ---- WebAuthn --------------------------------------------------------
# Must match the public domain of the app EXACTLY.
# RP ID is the registrable domain (no scheme/port); Origin is scheme+host(+port).
# You're deploying under your own subdomain with TLS terminated at your
# external nginx - so both of these must be that subdomain, not this
# container's internal port. Example (replace with your real subdomain,
# only in your local .env, never committed):
#   WEBAUTHN_RP_ID=dumbbureau.example.com
#   WEBAUTHN_ORIGIN=https://dumbbureau.example.com
# For local testing via http://localhost:8360 use "localhost" + the localhost origin.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=DumbBureau
WEBAUTHN_ORIGIN=http://localhost:8360

# ---- Storage ---------------------------------------------------------
# SQLite database location (inside the container).
# If you change APPDATA_DIR, adjust DATABASE_URL to the same container path.
DATABASE_URL=sqlite:////appdata/dumbbureau/db.sqlite

# Host directory mounted into the container at /appdata/dumbbureau
# (database, templates, exports, logs). SQLite runs in WAL mode (see
# database.py) - back this directory up as a whole (db.sqlite AND
# db.sqlite-wal AND db.sqlite-shm together), not just the main file, or a
# backup taken mid-write can miss committed data still sitting in the WAL.
# Stop the backend (or use a filesystem/volume snapshot) before copying to
# guarantee a consistent backup; copying the live files with `cp` while the
# app is running can still capture an inconsistent set.
APPDATA_DIR=/appdata/dumbbureau

# ---- Networking / Security ------------------------------------------
# Comma/space separated list of trusted proxy IPs/CIDRs. The backend only
# trusts X-Forwarded-For/X-Real-IP (used for rate limiting) from these
# addresses - anyone else's headers are ignored and the raw TCP peer
# address is used instead (fails closed, not open).
#
# Set this to YOUR external nginx reverse proxy's fixed IP (the one with
# its own macvlan address). If that proxy sits behind Cloudflare and
# forwards Cloudflare's own X-Forwarded-For/CF-Connecting-IP through
# unchanged, you don't need to list Cloudflare's ranges here - only the
# LAST hop that talks directly to this container needs to be trusted;
# X-Forwarded-For is read as a chain and the original client (first entry)
# is used. Example:
#   TRUSTED_PROXY_IPS=192.168.188.20/32
TRUSTED_PROXY_IPS=

# Comma separated list of allowed CORS origins (the public URL users
# actually visit, i.e. your subdomain - not FRONTEND_PORT).
CORS_ORIGINS=http://localhost:8360

# ---- Token lifetimes -------------------------------------------------
# WebAuthn challenge validity (seconds).
CHALLENGE_TTL_SECONDS=300
# JWT session token validity (minutes).
ACCESS_TOKEN_TTL_MINUTES=60
# Invite token validity (days).
INVITE_TOKEN_TTL_DAYS=7
# Passkey recovery token validity (minutes).
RECOVERY_TOKEN_TTL_MINUTES=30

# ---- Logging ---------------------------------------------------------
LOG_LEVEL=INFO

# ---- Frontend behavior -------------------------------------------------
# Show the DE/EN language switcher on login/app pages. Default is English-
# only (no auto-detection from the browser's language). Set to true to
# bring the switcher back without any code changes.
SHOW_LANGUAGE_TOGGLE=false
